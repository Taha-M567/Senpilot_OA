# Reference only: the application reads process environment variables, not this file.
OPENAI_API_KEY=
SENPILOT_LLM_MODEL=gpt-6-luna
# Confirm the selected model supports strict Responses JSON Schema and at least
# the configured context size. Defaults are intentionally conservative.
SENPILOT_CONTEXT_TOKENS=128000
SENPILOT_INPUT_BUDGET=96000
SENPILOT_MAX_OUTPUT_TOKENS=4096
SENPILOT_MODEL_TIMEOUT=60
